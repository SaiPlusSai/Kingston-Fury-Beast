# UrbanShield API (local or AWS API Gateway)
VITE_API_URL=http://localhost:3000/api

# Amazon Location Service map rendering
VITE_AWS_LOCATION_REGION=us-east-1
VITE_AWS_LOCATION_MAP_NAME=my-map
VITE_AWS_LOCATION_API_KEY=YOUR_AWS_LOCATION_API_KEY

# Deployed example:
# VITE_API_URL=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/api
