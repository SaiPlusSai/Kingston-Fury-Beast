# Archivos y carpetas a ignorar por Git en el Monorepo HALO v2

# 1. Documentos y binarios académicos (no versionables)
ec01.pdf
*.pdf

# 2. Python (Prediction Service & IA)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.env
.venv
venv/
ENV/
env.bak/
venv.bak/

# 3. Datos y Modelos Locales (¡Nunca subir a Git!)
prediction-service/data/raw/*.csv
prediction-service/data/processed/*.csv
!prediction-service/data/raw/.gitkeep
!prediction-service/data/processed/.gitkeep

# 4. Node.js & React Native (si se instalan dependencias en la raíz o móvil)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

